            "variant": {
              "name": "ESP32C3_INPUTS",
              "type": "function-block",
              "variables": [
                {
                  "name": "EN",
                  "class": "input",
                  "type": {
                    "definition": "generic-type",
                    "value": "BOOL"
                  }
                },
                {
                  "name": "ENO",
                  "class": "output",
                  "type": {
                    "definition": "generic-type",
                    "value": "BOOL"
                  }
                },
                {
                  "name": "CELL_PIN_V",
                  "class": "output",
                  "type": {
                    "definition": "base-type",
                    "value": "REAL"
                  }
                },
                {
                  "name": "LOAD_PIN_V",
                  "class": "output",
                  "type": {
                    "definition": "base-type",
                    "value": "REAL"
                  }
                }
              ],
              "documentation": "ESP32-C3 input image: the two analogue pins in volts, each the mean of\n   ADC_SAMPLES readings with the factory eFuse calibration applied\n   (analogReadMilliVolts). OpenPLC's generic analogue inputs are raw and\n   uncalibrated, so the cell voltage would lose its DMM-checked accuracy.\n   Call first in the scan.\n\n   Pins and RC filters:\n     GPIO_2  Vload (top of RL) -> 4.7k series, 100nF to GND -> ADC.\n             tau 0.47 ms, fc 339 Hz.\n     GPIO_3  Vcell -> 27k / 39k divider, 100nF from ADC pin to GND.\n             Filter R is the divider's Thevenin resistance, 16k:\n             tau 1.6 ms, fc 99.8 Hz.\n   Keep GPIO 2 and 3 out of the board's pin mapping.\n\n   On a target other than an ESP32 the outputs are left alone, so they can\n   be forced from the debugger.",
              "extensible": false
            },
            "variable": {
              "name": "inputs",
              "class": "local",
              "type": {
                "definition": "user-data-type",
                "value": "ESP32C3_INPUTS"
              },
